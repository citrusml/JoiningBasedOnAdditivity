/*
 * Nextflow Configuration for NELSI Autocorrelated Yule Benchmark (v = 0.3, 0.6, 1.0)
 *
 * PhyloTree_Methods_Comparison/next_configs/nextflow_nelsi_yule.config をベースに作成:
 *   - 系統樹モデル: NELSI 自己相関モデル (nelsi_kishino)
 *   - 相関分散パラメータ: nelsi_v_list = [0.3, 0.6, 1.0]
 *   - 分類群数 N: [20, 32, 64, 128]
 *   - 発散度 D: [0.1, 0.2, 0.5, 1.0, 1.5, 2.0, 3.0]
 *   - 配列長 L: 500 aa, Indel率: [0.05, 0.1], 反復数: 100 (chunk_size = 20 -> 5シャード/条件)
 */

params {
    tree_model      = "nelsi"
    nelsi_v_list    = [0.3, 0.6, 1.0]
    taxa_list       = [20, 32, 64, 128]
    distances       = [0.1, 0.2, 0.5, 1.0, 1.5, 2.0, 3.0]
    lba_ratio       = 1.0
    length          = 500
    indel_rates     = [0.05, 0.1]
    replicates      = 100
    chunk_size      = 20
    methods_set     = "core"
    max_iter_search = 20
    seed            = 42
    outdir          = "results_nelsi_v06_v10"
}

process {
    cache         = 'lenient'
    executor      = 'lsf'
    queue         = 'mafft'
    errorStrategy = 'retry'
    maxRetries    = 5

    cpus   = 1
    memory = { 4.GB * task.attempt }
    time   = { 8.h * task.attempt }

    withName: RUN_NELSI_CHUNK {
        cpus   = 1
        memory = { 4.GB * task.attempt }
        time   = { 8.h * task.attempt }
    }

    withName: MERGE_RESULTS {
        cpus     = 1
        memory   = '4 GB'
        time     = '1h'
        executor = 'local'
    }
}

profiles {
    standard {
        process.executor = 'local'
        process.cpus     = 4
        process.memory   = '8 GB'
    }

    supercomputer {
        process.executor     = 'lsf'
        process.queue        = 'mafft'
        process.beforeScript = 'export PATH="$HOME/bin:$PATH"; eval "$(micromamba shell hook --shell bash)" 2>/dev/null && micromamba activate phylomethod_env 2>/dev/null || true; [ -n "$CONDA_PREFIX" ] && export PATH="$CONDA_PREFIX/bin:$PATH"; export NELSI_RSCRIPT="${NELSI_RSCRIPT:-${MAMBA_ROOT_PREFIX:-$HOME/.micromamba}/envs/nelsi_env/bin/Rscript}"'
    }

    test {
        params.nelsi_v_list = [0.6]
        params.taxa_list    = [20]
        params.distances    = [0.5]
        params.replicates   = 2
        params.chunk_size   = 2
        process.executor    = 'local'
        process.cpus        = 2
        process.memory      = '4 GB'
    }
}

manifest {
    name            = 'JoiningBasedOnAdditivity - NELSI Autocorrelated Variance (v=0.6, 1.0) Benchmark'
    author          = 'CitrusML'
    description     = 'Nextflow + LSF pipeline for NELSI autocorrelated relaxed-clock benchmark at v=0.6 and v=1.0.'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=22.10.0'
    version         = '1.0.0'
}
