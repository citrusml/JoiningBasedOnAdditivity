/*
 * Nextflow Configuration for NELSI Autocorrelated Yule Benchmark (v = 0.3, 0.6, 1.0)
 *
 * PhyloTree_Methods_Comparison の並列設計に準拠し、taxa数に応じてマルチコアCPU・メモリを配分:
 *   - RUN_NELSI_SMALL  (N = 20, 32): cpus = 4,  memory = 4 GB  * attempt, time = 4h  * attempt
 *   - RUN_NELSI_MEDIUM (N = 64)    : cpus = 4,  memory = 8 GB  * attempt, time = 8h  * attempt
 *   - RUN_NELSI_LARGE  (N = 128)   : cpus = 8,  memory = 12 GB * attempt, time = 16h * attempt
 */

params {
    tree_model      = "nelsi"
    nelsi_v_list    = [0.3, 0.6, 1.0]
    taxa_list       = [20, 32, 64, 128]
    distances       = [0.1, 0.2, 0.5, 1.0, 1.5, 2.0, 3.0]
    lba_ratio       = 1.0
    length          = 500
    indel_rates     = [0.05, 0.1]
    replicates      = 100
    chunk_size      = 20
    methods_set     = "core"
    max_iter_search = 20
    seed            = 42
    outdir          = "results_nelsi_v06_v10"
}

executor {
    name            = 'lsf'
    queueSize       = 200
    submitRateLimit = '10 sec'
}

process {
    cache         = 'lenient'
    executor      = 'lsf'
    queue         = 'mafft'
    errorStrategy = 'retry'
    maxRetries    = 2

    withName: RUN_NELSI_SMALL {
        cpus   = 4
        memory = { (4 * task.attempt).GB }
        time   = { (4 * task.attempt).h }
    }

    withName: RUN_NELSI_MEDIUM {
        cpus   = 4
        memory = { (6 + 2 * (task.attempt - 1)).GB }
        time   = { (6 * task.attempt).h }
    }

    withName: RUN_NELSI_LARGE {
        cpus   = 4
        memory = { (8 + 4 * (task.attempt - 1)).GB }
        time   = { (12 * task.attempt).h }
    }

    withName: MERGE_RESULTS {
        cpus     = 2
        memory   = '8 GB'
        time     = '2h'
        executor = 'local'
    }
}

profiles {
    standard {
        process.executor = 'local'
        process.cpus     = 4
        process.memory   = '8 GB'
    }

    supercomputer {
        process.executor     = 'lsf'
        process.queue        = 'mafft'
        process.beforeScript = 'export PATH="$HOME/bin:$PATH"; eval "$(micromamba shell hook --shell bash)" 2>/dev/null && micromamba activate phylomethod_env 2>/dev/null || true; [ -n "$CONDA_PREFIX" ] && export PATH="$CONDA_PREFIX/bin:$PATH"; export NELSI_RSCRIPT="${NELSI_RSCRIPT:-${MAMBA_ROOT_PREFIX:-$HOME/.micromamba}/envs/nelsi_env/bin/Rscript}"'
    }

    test {
        params.nelsi_v_list = [0.6]
        params.taxa_list    = [20]
        params.distances    = [0.5]
        params.indel_rates  = [0.1]
        params.replicates   = 2
        params.chunk_size   = 2
        process.executor    = 'local'
        process.cpus        = 2
        process.memory      = '4 GB'
    }
}

manifest {
    name            = 'JoiningBasedOnAdditivity - NELSI Autocorrelated Variance (v=0.3, 0.6, 1.0) Benchmark'
    author          = 'CitrusML'
    description     = 'Nextflow + LSF pipeline with taxa-tier multi-CPU allocation for NELSI autocorrelated benchmark.'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=22.10.0'
    version         = '1.1.0'
}
